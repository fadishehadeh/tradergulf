APP_NAME="Trader Gulf"
APP_URL=http://localhost/tradergulf/public
APP_ENV=local
APP_DEBUG=true

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tradergulf
DB_USERNAME=root
DB_PASSWORD=

SESSION_NAME=tradergulf_session

# On shared hosting where web root differs from BASE_PATH/public, set this:
# WEB_ROOT=/home/user/tradergulf.com

# Generate hash: php -r "echo password_hash('yourpassword', PASSWORD_BCRYPT);"
ADMIN_USER=admin
ADMIN_PASS_HASH=
